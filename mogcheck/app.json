{
  "expo": {
    "name": "MogCheck",
    "slug": "mogcheck",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "mogcheck",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mogcheck.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "MogCheck needs camera access to scan and analyze your facial proportions.",
        "NSPhotoLibraryUsageDescription": "MogCheck needs photo library access so you can upload existing photos for analysis.",
        "NSLocalNetworkUsageDescription": "MogCheck needs local network access during development so your iPhone can load the app bundle from your Mac.",
        "NSUserTrackingUsageDescription": "MogCheck uses this to show you relevant ads. Your data is never sold.",
        "NSLocationWhenInUseUsageDescription": "Required by third-party SDKs used for facial analysis. MogCheck does not use your location.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-router",
      "expo-tracking-transparency",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "MogCheck needs camera access to scan and analyze your facial proportions.",
          "enableMicrophonePermission": false
        }
      ],
      "./plugins/withVisionCameraFaceDetectorStillImageOnly",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BebasNeue-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9bda857b-bd2d-490d-b3a1-2a1d0fddd286"
      },
      "router": {}
    },
    "owner": "zachw126"
  }
}
